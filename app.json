{
  "expo": {
    "name": "Hifdh - Memorisation du Coran",
    "slug": "hifdh-app",
    "version": "1.11.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hifdh",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "19",
      "bundleIdentifier": "com.hifdh.app",
      "infoPlist": {
        "UIAppFonts": [
          "fonts/AmiriQuran.ttf",
          "fonts/Amiri-Regular.ttf",
          "fonts/Amiri-Bold.ttf"
        ],
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "versionCode": 19,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#04361F"
      },
      "package": "com.hifdh.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.24"
          }
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "3ac8b0ac-2a7f-4cc9-8ab4-56759c3aee41"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "mchiker"
  }
}
