{
  "name": "hifdh-admin",
  "version": "1.1.0",
  "private": true,
  "description": "Tableau de bord web de Hifdh : verification des bornes de toumoun, suivi des apprenants.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/*.test.mjs\"",
    "donnees:synchroniser": "node scripts/synchroniser-donnees.mjs",
    "donnees:verifier": "node scripts/synchroniser-donnees.mjs --verifier",
    "verifier:bornes": "node scripts/verifier-bornes.mjs",
    "falsifier:bornes": "node scripts/falsifier-bornes.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
