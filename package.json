{
  "name": "hifdh-app",
  "version": "1.4.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --import ./scripts/register-alias.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "verifier:donnees": "python data/quran/verifier_divisions.py",
    "verifier:pages": "python data/quran/verifier_pages.py",
    "recouper:pages": "python data/quran/verifier_pages.py --recouper-api",
    "engendrer:layout": "python data/quran/generer_layout_moushaf.py",
    "verifier:layout": "python data/quran/generer_layout_moushaf.py --verifier",
    "falsifier:layout": "python scripts/falsifier_layout.py",
    "verifier:polices": "python scripts/verifier_codes_polices.py",
    "engendrer:polices-ts": "node scripts/generer_polices_pages_ts.mjs",
    "verifier:polices-ts": "node scripts/generer_polices_pages_ts.mjs --verifier",
    "falsifier:polices": "python scripts/falsifier_codes_polices.py",
    "falsifier:moushaf": "python scripts/falsifier_moushaf.py",
    "falsifier:acces-texte": "python scripts/falsifier_acces_texte.py",
    "verifier:rapport": "python data/quran/rapport_divisions_estimees.py --verifier",
    "engendrer:rapport": "python data/quran/rapport_divisions_estimees.py",
    "verifier:supabase": "node scripts/banc_supabase.mjs",
    "verifier:flux": "node scripts/analyser-flux.mjs",
    "falsifier:tests": "python scripts/falsifier_tests_sync.py",
    "falsifier:rapport": "python scripts/falsifier_rapport.py",
    "falsifier:pages": "python scripts/falsifier_pages.py",
    "falsifier:renforcement": "python scripts/falsifier_renforcement.py",
    "build:apk": "gh workflow run android-apk.yml",
    "build:ipa": "gh workflow run ios-unsigned.yml"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.0",
    "expo-font": "~13.0.0",
    "expo-haptics": "~14.0.0",
    "expo-linear-gradient": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "~18.3.0",
    "typescript": "^5.3.0"
  },
  "private": true
}
