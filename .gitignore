node_modules/
.pnp/
.pnp.js

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Env
.env
.env.local
.env.*.local

# Supabase — ne jamais publier les fichiers locaux ni les secrets.
# En revanche supabase/schema.sql fait partie du code source (aucun secret,
# uniquement des tables et des politiques RLS) : il doit rester versionné.
supabase/.temp/
supabase/.branches/

# GitHub Actions secrets - les clés vont dans les secrets GitHub, pas ici
# Voir la documentation dans docs/SECRETS.md

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
*.tsbuildinfo

# Testing
coverage/

# Le depot de doublures des tests : un etat d'execution, ecrit par
# `scripts/doublures.mjs` et relu par le chargeur d'alias. Le versionner ferait
# qu'une doublure posee un jour resterait en place, et toute une serie de tests
# eprouverait des faux sans le dire.
#
# Le nom porte le PID du processus — un depot par fichier de test, pour que deux
# fichiers lances en parallele ne s'ecrasent pas. Le motif couvre donc les deux
# formes, l'ancienne comprise : un depot oublie d'une execution precedente ne
# doit pas se retrouver dans un commit.
scripts/doublures-deposees.json
scripts/doublures-deposees.*.json

# Python : les scripts de donnees sont lances en place, et l'interpreteur
# depose ses caches a cote d'eux. Regenerables, et propres a la machine.
__pycache__/
*.pyc

# Temporary
*.log

# Dossiers de travail : telechargements, export local du paquet, bundle extrait
# d'un IPA ou d'un APK. Regenerables, et volumineux.
#
# Le motif couvre aussi les FICHIERS `.tmp-*` : `.tmp-*/` seul laissait passer
# un `.tmp-message.txt` ecrit pour un `git commit -F`, qu'un `git add -A`
# embarque alors dans le commit.
.tmp-*
.tmp-main.jsbundle

# Projets natifs : regeneres par `expo prebuild --clean`, jamais versionnes.
# Un dossier `ios/` versionne porte ses references de signature et devient une
# source constante de conflits a chaque mise a jour d'Expo.
/ios/
/android/
